  {
    "id": "data.microdeposits.traceNumber.backfill",
    "label": "Fill status and trace number on existing microdeposits",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "copy the trace number from the original activity",
        "sql": "UPDATE \"public\".\"microdeposits\" m\n              SET \"status\" = 'microdeposit',\n                \"traceNumber\" = w.\"payload\"->'event_object'->'source'->>'trace_number'\n              FROM \"public\".\"webhook_events\" w\n              WHERE w.\"category\" = 'virtual_account.activity'\n                AND w.\"payload\"->'event_object'->>'id' = m.\"bridgeActivityId\""
      }
    ],
    "postcheck": []
  },
  {
    "id": "data.webhook_events.acctverify.requeue",
    "label": "Reprocess ignored account-verification deposits",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "mark ignored ACCTVERIFY activity as pending so the sweeper records it",
        "sql": "UPDATE \"public\".\"webhook_events\"\n              SET \"status\" = 'Pending', \"error\" = NULL\n              WHERE \"category\" = 'virtual_account.activity'\n                AND \"status\" = 'Ignored'\n                AND \"payload\"->'event_object'->'source'->>'description' ~* '\\mACCTVERIFY\\M'\n                AND \"payload\"->'event_object'->>'amount' ~ '^0*\\.[0-9]+$'"
      }
    ],
    "postcheck": []
  }
]